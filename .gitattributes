* text=auto

# 构建脚本必须是 LF —— CRLF 会让 bash 把 `set -o pipefail` 解析成
# `pipefail\r`（invalid option name），CI 里直接挂掉。
*.sh   text eol=lf
*.bash text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf

# 二进制/归档不参与换行转换
*.png  binary
*.jpg  binary
*.jar  binary
*.keystore binary
*.tgz  binary
*.zip  binary
